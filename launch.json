    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run ShipSmart Flask app",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/SmartPantry_Complete/app.py",
            "cwd": "${workspaceFolder}/SmartPantry_Complete",
            "python": "${workspaceFolder}/SmartPantry_Complete/.venv/Scripts/python.exe",
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against ShipSmart",
            "url": "http://127.0.0.1:5000",
            "webRoot": "${workspaceFolder}"
        }
    ]
}